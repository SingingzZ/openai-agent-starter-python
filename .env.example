# ==============================================================================
# EdgeOne Makers · OpenAI Agents Starter (Python) — 环境变量示例
# ==============================================================================
# 用法：
#   1. 复制本文件为 .env           cp .env.example .env
#   2. 将下面的占位符替换为真实值
#   3. .env 已被 .gitignore 忽略，切勿提交到仓库
#
# 变量读取位置：agents/chat/index.py（第 37-42 行）
#   api_key  = os.getenv("AI_GATEWAY_API_KEY")
#   base_url = os.getenv("AI_GATEWAY_BASE_URL")
#   model    = os.getenv("AI_GATEWAY_MODEL", "@makers/deepseek-v4-flash")
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. AI_GATEWAY_API_KEY  【必填】
# ------------------------------------------------------------------------------
# 作用：调用大模型的鉴权密钥，兼容 OpenAI 协议。
# 获取：EdgeOne Makers 控制台 → Models → API Key → 新建
#       https://edgeone.ai/makers
# 说明：在 Makers 平台上部署时，该变量通常由平台自动注入，
#       无需手动配置；本地调试时才需要自己填写。
AI_GATEWAY_API_KEY=
# ↑ 本地调试请在此填写你的 Key。请勿把真实 Key 写入本文件后提交。


# ------------------------------------------------------------------------------
# 2. AI_GATEWAY_BASE_URL  【必填】
# ------------------------------------------------------------------------------
# 作用：模型网关地址，SDK 通过它发起 OpenAI 兼容请求。
# 取值：使用 Makers 内置网关时保持默认值；
#       使用其他兼容供应商（如 DeepSeek 原生、自建代理）时替换为其地址。
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1


# ------------------------------------------------------------------------------
# 3. AI_GATEWAY_MODEL  【选填，有默认值】
# ------------------------------------------------------------------------------
# 作用：指定调用的模型 ID。
# 默认：@makers/deepseek-v4-flash（平台内置免费模型，有额度上限）
# 示例：
#   @makers/deepseek-v4-flash       平台内置模型
#   deepseek/deepseek-chat          已在控制台托管厂商 Key 时的写法
#   deepseek-chat                   直连原生供应商时的写法
# 注意：若在上方使用了非 Makers 的 BASE_URL，这里需改成该供应商对应的模型 ID。
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash


# ------------------------------------------------------------------------------
# 4. AMAP_API_KEY  【预留，选填】
# ------------------------------------------------------------------------------
# 作用：高德地图开放平台 Key。当前代码暂未使用，为后续地图类功能预留
#       （实训文档 4.1 节模板中包含此变量）。
# 获取：高德开放平台 https://console.amap.com → 应用管理 → 创建应用 → 添加 Key
AMAP_API_KEY=
