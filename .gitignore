# Dependencies
node_modules/
.venv/

# Build outputs
dist/

# EdgeOne generated files
.edgeone/
.edgeone.zip

# Environment variables — NEVER commit real secrets
# Keep .env.example tracked as the template (it must contain placeholders only).
.env
.env.*
!.env.example
*.env
agents-python/.env
agents-python/chat/.env

# Secret-ish files
*.pem
*.key
secrets.json
credentials.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.egg-info/
uv.toml
# Local toolchain pin — EdgeOne Makers runs Python 3.12; let each
# contributor manage their own pyenv/asdf without forcing a version.
.python-version

# Internal planning docs
plan/

# AI assistant local instructions
CLAUDE.md
AGENTS.md

# WorkBuddy local workspace data
.workbuddy/

# Network-audit client (WFP filter) writes logs to cwd using an
# unexpanded "%public%" path, littering the repo. Ignore it.
%public%/
